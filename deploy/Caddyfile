# Piloto NEXO — Fase 2 dominio: agroplaga.es principal; .farm legacy (API APK antigua + redirect web)

# Sitio principal (.es)
agroplaga.es, www.agroplaga.es {
	encode gzip

	redir /panel /panel/ permanent
	handle /panel* {
		uri strip_prefix /panel
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	@apk path /ayuda/*.apk
	handle @apk {
		root * /srv/landing
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=AgroPlaga.apk"
		file_server
	}

	handle {
		root * /srv/landing
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

# Legacy .farm — mantiene /api para APK antigua; web y panel redirigen a .es
agroplaga-ai.farm {
	encode gzip

	@legacy_api path /api/* /docs* /openapi.json
	handle @legacy_api {
		reverse_proxy backend:8000
	}

	handle {
		redir https://agroplaga.es{uri} permanent
	}
}
