# Copia a .env y rellena (nunca subas .env al repo).
# Clave gratuita: https://data.eppo.int/
EPPO_API_KEY=
# Roboflow Universe (gratis): https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=
# Notificaciones in-app (Fase 1-3) + push FCM (Fase 4)
NOTIFICATIONS_ENABLED=true
PILOT_SCAN_GOAL=1000
# Activar solo con cuenta de servicio montada (ver docs/FIREBASE_SETUP.md)
FCM_ENABLED=false
# FIREBASE_CREDENTIALS=/secrets/firebase-service-account.json
