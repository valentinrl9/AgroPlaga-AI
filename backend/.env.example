# Backend environment variables (desarrollo local)
DATABASE_URL=postgresql+psycopg://plagaia:plagaia@localhost:5432/plagaia_db

# Seguridad — en producción usar un valor aleatorio de 32+ caracteres
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
ALLOW_INSECURE_SECRETS=true
DOCS_ENABLED=true

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=AgroPlaga AI
REGISTRATION_MODE=open

# Demo local (solo desarrollo)
DEMO_SEED_USERS=true
DEMO_RESET_PASSWORDS=true
DEMO_USERS_PASSWORD=nexo1234
CLIMATE_PREVIEW_OPEN=true
SIEX_PREVIEW_OPEN=true

# CORS (solo relevante para web-panel en navegador)
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=none

# Optional admin bootstrap user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin

# Producción (docker-compose.pilot.yml):
# ENVIRONMENT=pilot
# ALLOW_INSECURE_SECRETS=false
# SECRET_KEY=<generar con: python -c "import secrets; print(secrets.token_urlsafe(48))">
# REGISTRATION_MODE=invite_only
# DOCS_ENABLED=false
# DEMO_SEED_USERS=false
# CLIMATE_PREVIEW_OPEN=false
# SIEX_PREVIEW_OPEN=false
